# Copy to .env.local for local overrides. Do not commit real values.
# Analytics run only on production builds (see src/components/site-analytics.tsx).

# Google Analytics 4 (public measurement ID; set on Netlify for ui.minidev.pro)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Plausible (alternative to GA; pick one or neither)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ui.minidev.pro

# Google Search Console HTML tag verification (meta tag, server-only)
# GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
