# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MiniDev audit output
shots/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

node_modules/
/shots/
/npm-pack/
*.tgz

# Local Netlify folder
.netlify

# generated by tools/build-registry.mjs (runs before dev and build)
/public/r/
/src/lib/component-props.ts

# private notes and local scratch (never published)
/internal/
/fixtures/
/Claude outputs/
